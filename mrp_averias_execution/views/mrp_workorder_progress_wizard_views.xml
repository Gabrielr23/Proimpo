<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_workorder_progress_wizard_form" model="ir.ui.view">
        <field name="name">mrp.workorder.progress.wizard.form</field>
        <field name="model">mrp.workorder.progress.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar avance">
                <field name="workorder_id" invisible="1"/>
                <group>
                    <field name="cantidad"/>
                    <field name="reporta_averia"/>
                    <field name="cantidad_averias" invisible="not reporta_averia"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Registrar avance" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_workorder_progress_wizard" model="ir.actions.act_window">
        <field name="name">Registrar avance</field>
        <field name="res_model">mrp.workorder.progress.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_workorder_id': active_id}</field>
    </record>

    <!--
        PASO MANUAL EN STUDIO (no se hace por XML, a propósito: ver
        nota en mrp_averia_linea.py sobre por qué). Agregar en la
        orden de trabajo, junto a Iniciar/Pausar, un botón que llame a
        esta acción:

            <button name="%(action_mrp_workorder_progress_wizard)d"
                    type="action" string="Registrar avance"
                    class="btn-primary"
                    invisible="state != 'progress'"/>

        (mismo mecanismo que ya usaste para el botón "Tipificar":
        modo desarrollador > vista form > agregar línea de código).
    -->

</odoo>
