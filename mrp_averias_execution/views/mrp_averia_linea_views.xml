<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_averia_linea_form" model="ir.ui.view">
        <field name="name">mrp.averia.linea.form</field>
        <field name="model">mrp.averia.linea</field>
        <field name="arch" type="xml">
            <form string="Registro Averías">
                <sheet>
                    <group>
                        <field name="workcenter_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="production_id" readonly="1"/>
                        <field name="operacion_id" readonly="1"/>
                    </group>
                    <field name="detalle_ids">
                        <list editable="bottom">
                            <field name="categoria_id"/>
                            <field name="cantidad"/>
                            <field name="descripcion"/>
                        </list>
                    </field>
                    <group>
                        <field name="cantidad_averias_total" readonly="1"/>
                    </group>
                    <field name="quality_check_id" invisible="1"/>
                    <field name="workcenter_tipo" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_averia_linea_list" model="ir.ui.view">
        <field name="name">mrp.averia.linea.list</field>
        <field name="model">mrp.averia.linea</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="create_date" string="Creado"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="operacion_id"/>
                <field name="cantidad_averias_total"/>
            </list>
        </field>
    </record>

    <!-- Acción para VER la lista completa (menú "Registro de Averías",
         ubicado en tiempo de ejecución por setup.py). Cada hoja
         individual se sigue abriendo desde el botón "Tipificar"
         (action_tipificar_averia en mrp_workcenter_productivity.py,
         que arma la acción con res_id ya resuelto); esta es solo para
         consultar/filtrar el histórico. -->
    <record id="action_mrp_averia_linea" model="ir.actions.act_window">
        <field name="name">Registro de Averías</field>
        <field name="res_model">mrp.averia.linea</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
