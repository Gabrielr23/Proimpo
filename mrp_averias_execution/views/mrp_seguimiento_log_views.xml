<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_seguimiento_log_list" model="ir.ui.view">
        <field name="name">mrp.seguimiento.log.list</field>
        <field name="model">mrp.seguimiento.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="fecha"/>
                <field name="user_id"/>
                <field name="accion"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="workcenter_id"/>
                <field name="tramo"/>
                <field name="campo"/>
                <field name="valor_anterior"/>
                <field name="valor_nuevo"/>
                <field name="linea_ref" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_seguimiento_log_search" model="ir.ui.view">
        <field name="name">mrp.seguimiento.log.search</field>
        <field name="model">mrp.seguimiento.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="workcenter_id"/>
                <field name="user_id"/>
                <filter string="Borrados" name="borrados" domain="[('accion', '=', 'borrar')]"/>
                <filter string="Ediciones" name="ediciones" domain="[('accion', '=', 'editar')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Orden de fabricación" name="group_of" context="{'group_by': 'production_id'}"/>
                    <filter string="Centro de trabajo" name="group_ct" context="{'group_by': 'workcenter_id'}"/>
                    <filter string="Fecha (día)" name="group_fecha" context="{'group_by': 'fecha:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_seguimiento_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Seguimiento de tiempo</field>
        <field name="res_model">mrp.seguimiento.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_mrp_seguimiento_log_search"/>
    </record>

</odoo>
