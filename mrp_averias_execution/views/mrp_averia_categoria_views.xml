<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_averia_categoria_list" model="ir.ui.view">
        <field name="name">mrp.averia.categoria.list</field>
        <field name="model">mrp.averia.categoria</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tipo_centro_trabajo"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_averia_categoria_form" model="ir.ui.view">
        <field name="name">mrp.averia.categoria.form</field>
        <field name="model">mrp.averia.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo_centro_trabajo"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_averia_categoria_search" model="ir.ui.view">
        <field name="name">mrp.averia.categoria.search</field>
        <field name="model">mrp.averia.categoria</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archivadas"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_tipo" string="Tipo de Centro de Trabajo"
                            context="{'group_by': 'tipo_centro_trabajo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_averia_categoria" model="ir.actions.act_window">
        <field name="name">Categorías de Avería</field>
        <field name="res_model">mrp.averia.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- El <menuitem> se ubica en tiempo de ejecución (ver
         models/setup.py y data/menu_placement.xml), no acá, para no
         depender de un xml_id de menú ajeno adivinado. -->

</odoo>
