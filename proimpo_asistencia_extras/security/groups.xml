<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: res.groups ya no tiene 'category_id' (ahora 'privilege_id') ni 'users'
         (ahora 'user_ids'). El grupo se crea sin categoria; el administrador ya tiene
         acceso total por base.group_system (ver hr_attendance.py). Asignar el grupo a
         los aprobadores de nomina/RRHH desde Ajustes > Usuarios. -->
    <record id="group_asistencia_ver_todo" model="res.groups">
        <field name="name">Asistencias: aprobar todas (Nomina/RRHH)</field>
    </record>
</odoo>
