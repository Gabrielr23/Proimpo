<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cargar_novedades_form" model="ir.ui.view">
        <field name="name">proimpo.cargar.novedades.form</field>
        <field name="model">proimpo.cargar.novedades</field>
        <field name="arch" type="xml">
            <form string="Cargue masivo de novedades">
                <group>
                    <field name="batch_id"
                           options="{'no_create': True}"/>
                    <field name="archivo" filename="nombre_archivo"/>
                    <field name="nombre_archivo" invisible="1"/>
                    <field name="reemplazar"/>
                    <field name="recalcular"/>
                </group>
                <group string="Resultado" invisible="not resultado">
                    <field name="resultado" nolabel="1" readonly="1"/>
                </group>
                <div class="alert alert-info" role="status">
                    <strong>Formato del Excel:</strong> primera fila = encabezados.
                    Columnas: <b>Cédula</b> (o <b>Nombre</b>), y las novedades por código.
                    Horas extra en HORAS: HED, HEN, HRN, HEDDF, HRDDF, HENDF, HRNDF.
                    Comisiones/bonificaciones en VALOR: COM, BON, BONNS.
                </div>
                <footer>
                    <button name="action_cargar" type="object"
                            string="Cargar novedades" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cargar_novedades" model="ir.actions.act_window">
        <field name="name">Cargar novedades (Excel)</field>
        <field name="res_model">proimpo.cargar.novedades</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cargar_novedades"
              name="Cargar novedades (Excel)"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_cargar_novedades"
              sequence="90"/>

</odoo>
