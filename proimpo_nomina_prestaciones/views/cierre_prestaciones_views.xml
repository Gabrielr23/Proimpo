<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cierre_prestaciones_wizard_form" model="ir.ui.view">
        <field name="name">cierre.prestaciones.wizard.form</field>
        <field name="model">cierre.prestaciones.wizard</field>
        <field name="arch" type="xml">
            <form string="Cierre de prestaciones">
                <group>
                    <group>
                        <field name="fecha_corte"/>
                    </group>
                    <group>
                        <field name="smmlv"/>
                        <field name="aux_transporte"/>
                    </group>
                </group>
                <p class="text-muted">
                    Recalcula el consolidado de cesantias, intereses, prima y vacaciones a la
                    fecha de corte (base = ultimo basico + promedio de variables) y lo compara
                    contra la provision contabilizada, mostrando el ajuste.
                </p>
                <footer>
                    <button name="action_generar_reporte" type="object"
                            string="Generar reporte de consolidado" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cierre_prestaciones" model="ir.actions.act_window">
        <field name="name">Cierre de prestaciones</field>
        <field name="res_model">cierre.prestaciones.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cierre_prestaciones"
              name="Cierre de prestaciones"
              parent="hr.menu_hr_root"
              action="action_cierre_prestaciones"
              sequence="91"/>
</odoo>
