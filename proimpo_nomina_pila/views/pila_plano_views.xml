<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Boton en el lote de nomina para generar el archivo PILA del mes -->
    <record id="hr_payslip_run_form_pila" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.pila</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generar_pila_plano" type="object"
                        string="Generar archivo PILA" class="btn-primary"
                        help="Genera el archivo plano PILA del mes de causacion (ambas quincenas)."/>
            </xpath>
        </field>
    </record>

    <!-- Campos adicionales de PILA en el contrato -->
    <record id="hr_contract_view_form_pila_gen" model="ir.ui.view">
        <field name="name">hr.contract.form.pila.gen</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="proimpo_nomina_pila.hr_contract_view_form_pila"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pila_municipio_code']" position="after">
                <field name="pila_arl_class"/>
                <field name="pila_centro_trabajo"/>
            </xpath>
        </field>
    </record>

    <!-- Centro de trabajo por defecto en la compania -->
    <record id="res_company_form_pila" model="ir.ui.view">
        <field name="name">res.company.form.pila</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pila_centro_trabajo_def"/>
            </xpath>
        </field>
    </record>
</odoo>
