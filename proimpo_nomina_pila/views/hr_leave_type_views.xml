<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_form_pila" model="ir.ui.view">
        <field name="name">hr.leave.type.form.pila</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <!-- Tras 'Aprobacion' (campo del formulario base, siempre visible) -->
            <field name="leave_validation_type" position="after">
                <field name="pila_novedad"/>
            </field>
        </field>
    </record>

    <record id="action_pila_novedad_asignar" model="ir.actions.server">
        <field name="name">Asignar Novedad PILA por defecto</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.pila_novedad_asignar_defecto()</field>
    </record>
</odoo>
