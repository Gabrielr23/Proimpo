<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_rtf_button" model="ir.ui.view">
        <field name="name">hr.payslip.form.rtf.button</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_report_rtf)d" type="action"
                        string="Auditoría RTF" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
