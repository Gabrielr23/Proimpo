<odoo>
  <data>
    <record id="account_state_file_payment_view_form" model="ir.ui.view">
      <field name="name">account_state_file_payment_view_form</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='memo']" position="after">
          <field name="file_status" readonly="1"/>
          <field name="bank" readonly="1"/>
        </xpath>
      </field>
    </record>

    <record id="account_state_file_payment_view_form_change" model="ir.ui.view">
      <field name="name">account_state_file_payment_view_form_change</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_form"/>
      <field name="arch" type="xml">
        <!-- MIGRACION 19.0: se fusionan los bloques position="attributes"
             repetidos sobre el mismo campo. Antes habia dos bloques por
             campo (uno para @groups y otro para @readonly); con la nueva
             validacion de arch conviene declarar los atributos una sola vez
             por campo. -->
        <field name="file_status" position="attributes">
          <attribute name="groups">generate_bank_file.group_enable_pay</attribute>
          <attribute name="readonly">0</attribute>
        </field>
        <field name="bank" position="attributes">
          <attribute name="groups">generate_bank_file.group_enable_pay</attribute>
          <attribute name="readonly">0</attribute>
        </field>
      </field>
    </record>

    <record id="account_state_file_payment_view_tree" model="ir.ui.view">
      <field name="name">account_state_file_payment_view_tree</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='state']" position="after">
          <field name="file_status" widget="badge" decoration-info="file_status == 'no_generado'"  decoration-success="file_status == 'generado'"/>
          <field name="bank" widget="badge" decoration-info="bank == 'otros'" decoration-success="bank == 'bancolombia'" />
        </xpath>
      </field>
    </record>

  </data>
</odoo>
