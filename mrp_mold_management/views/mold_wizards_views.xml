<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== INHABILITAR MOLDE ==================== -->
    <record id="view_mold_disable_wizard_form" model="ir.ui.view">
        <field name="name">mrp.mold.disable.wizard.form</field>
        <field name="model">mrp.mold.disable.wizard</field>
        <field name="arch" type="xml">
            <form string="Inhabilitar molde">
                <field name="mold_id" invisible="1"/>

                <div class="alert alert-warning" role="alert"
                     invisible="bom_count == 0 and workorder_count == 0">
                    Este molde se usa hoy en <field name="bom_count" readonly="1"/>
                    LdM y en <field name="workorder_count" readonly="1"/>
                    órdenes de trabajo abiertas. Si lo inhabilitas, las LdM lo
                    conservan y no se modifican; en las órdenes nuevas no se
                    asignará y quien responde por la orden de fabricación
                    recibirá una actividad para ajustar molde y ciclo.
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="bom_count != 0 or workorder_count != 0">
                    Ninguna LdM ni orden abierta usa este molde. Se puede
                    inhabilitar sin afectar a nadie.
                </div>

                <group string="LdM donde es el molde principal"
                       invisible="not principal_operation_ids">
                    <field name="principal_operation_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="bom_id"/>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                        </list>
                    </field>
                </group>
                <group string="LdM donde es molde alternativo"
                       invisible="not alternative_operation_ids">
                    <field name="alternative_operation_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="bom_id"/>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                        </list>
                    </field>
                </group>
                <group string="Órdenes de trabajo abiertas con este molde"
                       invisible="not workorder_ids">
                    <field name="workorder_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="production_id"/>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_confirm" type="object"
                            string="Inhabilitar de todos modos"
                            class="btn-primary"/>
                    <button name="action_download" type="object"
                            string="Descargar LdM afectadas (Excel)"
                            icon="fa-download" class="btn-secondary"
                            invisible="bom_count == 0 and workorder_count == 0"/>
                    <button string="Cancelar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==================== CONFIGURACIÓN DE ALERTAS ==================== -->
    <record id="view_mold_alert_config_form" model="ir.ui.view">
        <field name="name">mrp.mold.alert.config.form</field>
        <field name="model">mrp.mold.alert.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Alertas de Moldes">
                <div class="alert alert-info" role="alert">
                    Avisos cuando un molde está fuera de su ubicación de
                    almacenamiento. Llegan como actividades, una sola vez por
                    salida.
                </div>
                <group string="Molde en reparación">
                    <group>
                        <field name="days_repair"/>
                        <field name="chief_user_id"/>
                    </group>
                    <group>
                        <field name="days_escalation"/>
                        <field name="boss_user_id"/>
                    </group>
                </group>
                <group string="Molde en un proveedor externo produciendo">
                    <group>
                        <field name="days_external"/>
                    </group>
                    <group>
                        <field name="external_user_id"/>
                    </group>
                </group>
                <group string="Otras salidas (ni reparación ni proveedor externo)">
                    <field name="days_maquila"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Guardar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mold_alert_config" model="ir.actions.act_window">
        <field name="name">Configuración de Alertas</field>
        <field name="res_model">mrp.mold.alert.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mold_alert_config"
              name="Configuración de Alertas"
              parent="mrp_mold_management.menu_mold_root"
              action="action_mold_alert_config"
              groups="maintenance.group_equipment_manager"
              sequence="8"/>

    <!-- ==================== ACTUALIZACIÓN MASIVA ==================== -->
    <!-- Aparece en Acción (⚙) al seleccionar moldes en la lista. -->
    <record id="action_server_propagate_cycle" model="ir.actions.server">
        <field name="name">Propagar ciclo a las LdM</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="state">code</field>
        <field name="code">action = records.action_propagate_cycle()</field>
    </record>

</odoo>
