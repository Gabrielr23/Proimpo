<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Confirmado por diagnóstico en vivo (no una suposición): la vista
        base del formulario de Operaciones de LdM es
        mrp.mrp_routing_workcenter_form_view (sin padre — es la raíz). Las
        extensiones de mrp_workorder y de Studio en esta instancia heredan
        de esa misma base de forma independiente entre sí, así que agregar
        una tercera extensión apoyada en la misma base es seguro: Odoo las
        combina todas al renderizar, sin que compitan entre ellas.
    -->
    <record id="view_mrp_routing_workcenter_form_mold" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.mold</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="mold_id"/>
            </xpath>
        </field>
    </record>

</odoo>

