<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORMULARIO ==================== -->
    <record id="view_maintenance_equipment_form_mold" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.mold</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_revisions" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="not is_mold">
                    <field name="revision_count" widget="statinfo" string="Revisiones"/>
                </button>
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="is_mold" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Especificaciones de Molde" invisible="not is_mold">
                    <group>
                        <group string="Producción">
                            <field name="cavity_count"/>
                            <field name="cycle_time_theoretical"/>
                            <field name="cycle_time_current"/>
                            <field name="hourly_target" readonly="1"/>
                            <field name="standard_weight_g"/>
                            <field name="mold_weight_kg"/>
                            <field name="setup_hours"/>
                        </group>
                        <group string="Compatibilidad">
                            <field name="compatible_workcenter_ids" widget="many2many_tags"/>
                            <field name="qualified_operation_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ==================== LISTA (marca is_mold visible) ==================== -->
    <record id="view_maintenance_equipment_list_mold" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.mold</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_mold" optional="hide"/>
                <field name="cavity_count" optional="hide"/>
                <field name="cycle_time_current" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== BÚSQUEDA: filtro Moldes ==================== -->
    <record id="view_maintenance_equipment_search_mold" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.mold</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_is_mold" string="Moldes"
                        domain="[('is_mold', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== ACCIÓN Y MENÚ: Moldes ==================== -->
    <record id="action_mold_equipment" model="ir.actions.act_window">
        <field name="name">Moldes</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_mold', '=', True)]</field>
        <field name="context">{'default_is_mold': True, 'search_default_filter_is_mold': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra tu primer molde
            </p>
            <p>
                Cada molde se gestiona como un equipo de mantenimiento: hereda
                calendario preventivo, solicitudes correctivas y técnico
                asignado, con sus cavidades, ciclo y centros de trabajo
                compatibles.
            </p>
        </field>
    </record>

    <!-- Sin parent: el post_init_hook lo cuelga bajo la app Mantenimiento. -->
    <menuitem id="menu_mold_equipment"
              name="Moldes"
              action="action_mold_equipment"
              sequence="15"/>

</odoo>
