<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_sync_mold_purchases" model="ir.cron">
            <field name="name">Moldes: sincronizar compras y llegadas</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_mold_purchases()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_mold_alerts" model="ir.cron">
            <field name="name">Moldes: generar alertas</field>
            <field name="model_id" ref="model_mrp_mold_alerts"/>
            <field name="state">code</field>
            <field name="code">model._cron_alertas_moldes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
