<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_loan_form" model="ir.ui.view">
        <field name="name">hr.employee.loan.form</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <form string="Préstamo / Libranza">
                <header>
                    <button name="action_open" string="Activar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Volver a borrador" type="object"
                            invisible="state not in ('open','cancel')"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('cancel','done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Libranza Banco X"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="loan_type"/>
                            <field name="partner_id" invisible="loan_type == 'prestamo'"/>
                            <field name="date"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="installment_amount"/>
                            <field name="frequency"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuotas descontadas">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="payslip_id"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_loan_list" model="ir.ui.view">
        <field name="name">hr.employee.loan.list</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <list string="Préstamos / Libranzas" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_type"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="installment_amount"/>
                <field name="frequency"/>
                <field name="amount_paid"/>
                <field name="amount_residual"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_loan_search" model="ir.ui.view">
        <field name="name">hr.employee.loan.search</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <filter name="open" string="Activos" domain="[('state','=','open')]"/>
                <filter name="done" string="Pagados" domain="[('state','=','done')]"/>
                <separator/>
                    <filter name="g_employee" string="Empleado" context="{'group_by':'employee_id'}"/>
                    <filter name="g_type" string="Tipo" context="{'group_by':'loan_type'}"/>
                
            </search>
        </field>
    </record>

    <record id="action_hr_employee_loan" model="ir.actions.act_window">
        <field name="name">Préstamos y Libranzas</field>
        <field name="res_model">hr.employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <menuitem id="menu_hr_employee_loan"
              name="Préstamos y Libranzas"
              parent="hr.menu_hr_root"
              action="action_hr_employee_loan"
              sequence="90"/>

</odoo>
