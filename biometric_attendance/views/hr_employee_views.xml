<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extender vista de empleado -->
    <record id="view_employee_form_inherit_biometric" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.biometric</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_biometric_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-fingerprint"
                        invisible="biometric_log_count == 0">
                    <field name="biometric_log_count" widget="statinfo" string="Registros"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>