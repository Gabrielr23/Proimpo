<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_biometric_log_list" model="ir.ui.view">
        <field name="name">biometric.log.list</field>
        <field name="model">biometric.log</field>
        <field name="arch" type="xml">
            <list string="Registros Biométricos" create="false" edit="false">
                <field name="timestamp"/>
                <field name="employee_id"/>
                <field name="employee_cedula"/>
                <field name="ip_address"/>
                <field name="status" widget="badge" decoration-success="status=='check_in'" decoration-info="status=='check_out'"/>
                <field name="create_date" string="Recibido"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_biometric_log_form" model="ir.ui.view">
        <field name="name">biometric.log.form</field>
        <field name="model">biometric.log</field>
        <field name="arch" type="xml">
            <form string="Registro Biométrico" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="employee_cedula" readonly="1"/>
                        </group>
                        <group>
                            <field name="timestamp" readonly="1"/>
                            <field name="ip_address" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="status" readonly="1" widget="badge" decoration-success="status=='check_in'" decoration-info="status=='check_out'"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Datos Recibidos" colspan="2">
                        <field name="payload" readonly="1" rows="8" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_biometric_log_search" model="ir.ui.view">
        <field name="name">biometric.log.search</field>
        <field name="model">biometric.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="employee_cedula"/>
                <field name="ip_address"/>
                <field name="timestamp"/>
                <field name="status"/>
                <filter string="Check In" name="check_in" domain="[('status', '=', 'check_in')]"/>
                <filter string="Check Out" name="check_out" domain="[('status', '=', 'check_out')]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('timestamp', '&gt;=', context_today())]"/>
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Tipo" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Menú -->
    <record id="action_biometric_log" model="ir.actions.act_window">
        <field name="name">Registros Biométricos</field>
        <field name="res_model">biometric.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros biométricos todavía
            </p>
            <p>
                Los registros aparecerán aquí cuando el dispositivo biométrico envíe datos al endpoint /api/biometric
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_biometric_root"
              name="Biométrico"
              web_icon="biometric_attendance,static/description/icon.png"
              sequence="85"/>
    
    <menuitem id="menu_biometric_logs"
              name="Registros"
              parent="menu_biometric_root"
              action="action_biometric_log"
              sequence="10"/>
</odoo>