<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_ces" model="ir.ui.view">
        <field name="name">hr.contract.form.cesantias</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <!-- v1.4.3: el salario va dentro de un <div class="o_row"> junto al texto "/ mes";
                 el fondo se inserta DESPUES de ese div para que tenga su propia fila y etiqueta -->
            <xpath expr="//field[@name='wage']/parent::div" position="after">
                <field name="fondo_cesantias"/>
            </xpath>
        </field>
    </record>
</odoo>
