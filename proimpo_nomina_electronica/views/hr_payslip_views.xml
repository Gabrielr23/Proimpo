<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_ne" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ne_generar" type="object"
                        string="Generar NE (firmar)" class="btn-secondary"/>
                <button name="action_ne_validar_xsd" type="object"
                        string="Validar XSD DIAN" class="btn-secondary"/>
                <button name="action_ne_enviar" type="object"
                        string="Enviar a DIAN (set de pruebas)" class="btn-primary"
                        invisible="ne_state not in ('generated','rejected')"/>
                <button name="action_ne_consultar" type="object"
                        string="Consultar estado DIAN"
                        invisible="not ne_zip_key"/>
                <button name="action_ne_corregir" type="object"
                        string="Corregir (nota de reemplazo)" class="btn-secondary"
                        invisible="ne_state != 'accepted' or ne_tipo_nota"
                        confirm="Se creará un recibo en borrador que reemplazará ante la DIAN al recibo actual. ¿Continuar?"/>
                <button name="action_ne_descargar" type="object"
                        string="Descargar XML"
                        invisible="not ne_xml"/>
                <field name="ne_state" widget="statusbar"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Nómina Electrónica" name="ne">
                    <group>
                        <group string="Documento DIAN">
                            <field name="ne_numero" readonly="1"/>
                            <field name="ne_fecha_gen" readonly="1"/>
                            <field name="ne_cune" readonly="1"/>
                            <field name="ne_zip_key" readonly="1"/>
                            <field name="ne_document_id" readonly="1"/>
                        </group>
                        <group string="Mensaje DIAN">
                            <field name="ne_mensaje" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Nota de ajuste (tipo 103)">
                            <field name="ne_tipo_nota"/>
                            <field name="ne_reemplaza_id" invisible="not ne_reemplaza_id"/>
                            <field name="origin_payslip_id" invisible="ne_tipo_nota != '2'" readonly="1"/>
                            <field name="ne_ajuste_ids" invisible="not ne_ajuste_ids" readonly="1"/>
                        </group>
                    </group>
                    <separator string="XML NominaIndividual / NominaIndividualDeAjuste (firmado)"/>
                    <field name="ne_xml" readonly="1" widget="ace" options="{'mode': 'xml'}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
