<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_ne" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ne_generar" type="object"
                        string="Generar Nómina Electrónica" class="btn-primary"/>
                <field name="ne_state" widget="statusbar"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Nómina Electrónica" name="ne">
                    <group>
                        <field name="ne_cune" readonly="1"/>
                    </group>
                    <field name="ne_xml" readonly="1" widget="ace" options="{'mode': 'xml'}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
