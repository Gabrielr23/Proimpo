<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="certificado_ingresos_wizard_form" model="ir.ui.view">
        <field name="name">certificado.ingresos.wizard.form</field>
        <field name="model">certificado.ingresos.wizard</field>
        <field name="arch" type="xml">
            <form string="Certificado de ingresos y retenciones (220)">
                <group>
                    <group>
                        <field name="anio"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="smmlv"/>
                        <field name="aux_transporte"/>
                    </group>
                </group>
                <p class="text-muted">
                    Consolida los pagos del ano por empleado en las casillas del formato 220.
                    Deja "Empleados" vacio para generar a todos los que tuvieron nomina en el ano.
                    Las casillas se toman del campo "Casilla Certificado 220" de cada regla salarial.
                </p>
                <footer>
                    <button name="action_generar_pdf" type="object"
                            string="Generar PDF (formato 220)" class="btn-primary"/>
                    <button name="action_generar_excel" type="object"
                            string="Excel de control" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_certificado_ingresos" model="ir.actions.act_window">
        <field name="name">Certificado de ingresos (220)</field>
        <field name="res_model">certificado.ingresos.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_certificado_ingresos"
              name="Certificado de ingresos (220)"
              parent="hr_payroll.menu_hr_payroll_root"
              action="action_certificado_ingresos"
              sequence="95"/>
</odoo>
