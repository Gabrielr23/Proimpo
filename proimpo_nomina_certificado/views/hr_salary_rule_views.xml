<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_form_cert220" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.cert220</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="cert220_casilla"/>
            </xpath>
        </field>
    </record>

    <record id="action_cert220_asignar" model="ir.actions.server">
        <field name="name">Asignar casillas Cert.220 por defecto</field>
        <field name="model_id" ref="hr_payroll.model_hr_salary_rule"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_salary_rule"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.cert220_asignar_defecto()</field>
    </record>
</odoo>
