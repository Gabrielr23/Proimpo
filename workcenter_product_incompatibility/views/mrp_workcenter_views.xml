<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario de centro de trabajo con incompatibilidades -->
    <record id="mrp_workcenter_form_view_incompatible" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.incompatible.products</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Productos Incompatibles" name="incompatible_products">
                    <group>
                        <group>
                            <field name="incompatible_product_ids" 
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="incompatible_product_count" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <div class="alert alert-warning" role="alert">
                            <p><strong>Productos Incompatibles:</strong></p>
                            <p>Este centro de trabajo NO puede procesar los productos 
                            seleccionados. El sistema bloqueará su asignación en 
                            órdenes de manufactura.</p>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>