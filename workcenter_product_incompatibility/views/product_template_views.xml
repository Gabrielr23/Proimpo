<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista formulario de producto con incompatibilidades (Odoo 18) -->
        <record id="product_template_form_view_incompatible_wc" model="ir.ui.view">
            <field name="name">product.template.form.incompatible.workcenters</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']" position="after">
                    <page string="Manufactura" name="manufacturing" invisible="type != 'product'">
                        <group>
                            <group string="Restricciones de Centros de Trabajo">
                                <field name="incompatible_workcenter_ids" 
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                        </group>
                        <group string="Información">
                            <div class="alert alert-info" role="alert">
                                <p><strong>Centros de Trabajo Incompatibles:</strong></p>
                                <p>Los centros de trabajo seleccionados NO podrán ser utilizados
                                para procesar este producto. El sistema evitará su asignación
                                automática y mostrará advertencias.</p>
                            </div>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Smart button en producto (Odoo 18) -->
        <record id="product_template_form_view_incomp_smart_button" model="ir.ui.view">
            <field name="name">product.template.form.incomp.smart.button</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(action_workcenter_incompatibility)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-ban"
                            invisible="incompatible_workcenter_count == 0">
                        <field name="incompatible_workcenter_count" 
                               widget="statinfo"
                               string="Incompatibles"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
