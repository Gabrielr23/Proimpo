<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_change_credit" model="ir.ui.view">
        <field name="name">Controlling the Credit Limit for Partners</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
		<page name="accounting" position="after">
			 <page string="Límite de crédito" name="credit_limit">				 
				<group>
						<group string="Bases" name="credit_limit_so">						
							<field name="my_credit_limit"  readonly="1" />
							<field name="check_credit_limit" readonly="1" />						
							<field name="my_credit_agent_change" readonly="1" />
							<field name="credit"  string="Cupo utilizado" readonly="1" />
							<field name="credit_limit_days"  string="Días de gracia:" readonly="1"/>
						</group>				
				</group>
			</page>
		</page>
        </field>
    </record>
    
        <record id="view_partner_change_credit_administrator" model="ir.ui.view">
        <field name="name">Controlling the Credit Limit for Partners</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_partner_change_credit"/>
        <!-- MIGRACION 19.0: si se reactiva esta linea, ir.ui.view.groups_id
             se llama ahora group_ids:
             <field name="group_ids" eval="[(6, 0, [ref('control_credit_limit.group_cartera')])]"/> -->
        <field name="arch" type="xml">
        <field name="check_credit_limit" position="attributes">
			<attribute name="groups">control_credit_limit.group_cartera</attribute>
			<attribute name="readonly">0</attribute>
		</field>
                <field name="my_credit_limit" position="attributes" >
			<attribute name="readonly">0</attribute>
		</field>
		<field name="my_credit_agent_change" position="attributes">
			<attribute name="readonly">0</attribute>
		</field>
        </field>
    </record>

    <record id="credit_limit_sale_order_add_pending" model="ir.ui.view">
        <field name="name">Sale Order Adding Pending</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
		<div name="button_box"  position="after">
		<field name="need_approval" invisible="1" />
		     <div class="oe_title" style="text-align:middle;color:red;width:100%;" invisible="not need_approval or state not in ('draft', 'sent')">
			<center><h1>Pendiente de aprobación</h1></center>
                    </div>
		</div>
        </field>
    </record>




</odoo>
