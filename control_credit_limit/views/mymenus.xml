<?xml  version="1.0"?>  
<odoo>   
	<record	id="sale_order_to_approve"	model="ir.ui.view">	
		<field	name="name">Órdenes para aprobar: cuestiones de límite de crédito</field>	
		<field	name="model">sale.order</field>	
		<field	name="arch"	type="xml">	
				<tree>
				    <field name="message_needaction" invisible="1"/>
				    <field name="name" string="Order Number"/>
				    <field name="date_order"/>
				    <field name="partner_id"/>
				    <field name="user_id"/>
				    <field name="amount_total" sum="Total Tax Included" widget="monetary" eval=""></field>
				    <field name="customer_balance" string="Total Debt" widget="monetary"/>
				    <field name="credit_limit" string="Credit Limit" widget="monetary" />
				    <field name="currency_id" invisible="1"/>
				    <field name="invoice_status"  invisible="1"/>
				    <field name="state" invisible="1"/>
				</tree>	
		</field>	
	</record>

	<record	id="view_customer_over_limit"	model="ir.ui.view">	
		<field	name="name">Clientes por encima del límite de crédito</field>	
		<field	name="model">res.partner</field>	
		<field	name="arch"	type="xml">	
				<tree>
		  		    <field name="display_name" string="Name"/>
				    <field name="function" invisible="1"/>
				    <field name="phone"/>
				    <field name="email"/>				
				    <field name="my_credit_limit"  string="Credit Limit"  widget="monetary" ></field>
				    <field name="credit" string="Invoiced Debt" sum="Total Tax Included" widget="monetary"></field>
				    <field name="over_limit" string="Over Limit" widget="monetary"></field>
				    <field name="user_id" invisible="1"/>
				    <field name="is_company" invisible="1"/>
				    <field name="country_id" invisible="1"/>
				    <field name="parent_id" invisible="1"/>
				    <field name="active" invisible="1"/>
				</tree>	
		</field>	
	</record>

	<record	id="view_customer_without_limit"	model="ir.ui.view">	
		<field	name="name">Clientes sin límite de crédito</field>	
		<field	name="model">res.partner</field>	
		<field	name="arch"	type="xml">	
				<tree>
		  		    <field name="display_name" string="Name"/>
				    <field name="function" invisible="1"/>
				    <field name="phone"/>
				    <field name="email"/>				
				    <field name="credit" sum="Total Tax Included" widget="monetary"></field>
				    <field name="user_id" invisible="1"/>
				    <field name="is_company" invisible="1"/>
				    <field name="country_id" invisible="1"/>
				    <field name="parent_id" invisible="1"/>
				    <field name="active" invisible="1"/>
				</tree>	
		</field>	
	</record>

	<record id="credit_limit_settings" model="ir.ui.view">
	    <field name="name">Configuración del límite de crédito</field>
	    <field name="model">credit.limit.config</field>
	    <field name="arch" type="xml">
		<form string="Credit Limit Settings" class="oe_form_configuration">
		    <group string="Credit Limit Settings">
		        <!-- label for="id" string="Sale Orders"/ -->
		        <div>
		            <div>
		                <label for="default_my_credit_limit"/>
		                <field name="default_my_credit_limit"/>
		            </div>

		            <div>
		                <field name="include_not_invoiced"/>
		                <label for="include_not_invoiced"/>
		            </div>

		            <div>
		                <field name="force_limit_fresh_orders"/>
		                <label for="force_limit_fresh_orders"/>
		            </div>
		        </div>
		    </group>
            <footer>
                <button string="Apply" type="object"
                    name="execute" class="oe_highlight"/>
                or
                <button string="Cancel" type="object"
                    name="cancel" class="oe_link"/>
            </footer>
		</form>
	    </field>
	</record>

	<record id="action_list_sale_to_approve" model="ir.actions.act_window">
        <field name="name">Órdenes para aprobar: límite de crédito</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="sale_order_to_approve"/>
		<field name="domain">[('need_approval', '=', True),'|',('state', '=','draft' ),('state', '=','sent' )]</field>
	</record>

	<record id="action_list_customer_over_credit_limit" model="ir.actions.act_window">
        <field name="name">Clientes por encima del límite de crédito</field>
        <field name="res_model">res.partner</field>
        <field name="view_id" ref="view_customer_over_limit"/>
		<field name="domain">[('over_limit','>',0),('check_credit_limit','=',True)]</field>
	</record>

    <record id="action_list_customer_without_limit" model="ir.actions.act_window">
        <field name="name">Clientes sin límite de crédito</field>
        <field name="res_model">res.partner</field>
        <field name="view_id" ref="view_customer_without_limit"/>
		<field name="domain">[('check_credit_limit', '=', False)]</field>
	</record>

	<record id="action_list_credit_limit_settings" model="ir.actions.act_window">
        <field name="name">Configuración del límite de crédito</field>
        <field name="res_model">credit.limit.config</field>
        <field name="view_id" ref="credit_limit_settings"/>
		<field name="view_mode">form</field>
	</record>
    
    <menuitem  id="my_credit_limit_menu"  
        name="Límite de crédito"  
        parent="sale.sale_menu_root"
	    groups="control_credit_limit.group_cartera"
        sequence="30">

		<menuitem  id="menu_list_sale_to_approve" 
		   	name="Órdenes de venta para aprobar" 
			action="action_list_sale_to_approve" 
    	   	groups="control_credit_limit.group_cartera"
        	sequence="10"/>

		<menuitem  id="menu_credit_limit_customers_over" 
		   	name="Clientes por encima del límite" 
			action="action_list_customer_over_credit_limit" 
    	   	groups="control_credit_limit.group_cartera"
        	sequence="20"/>

		<menuitem  id="menu_credit_limit_customers_with" 
		   	name="Clientes sin límite" 
			action="action_list_customer_without_limit" 
    	   	groups="control_credit_limit.group_cartera"
        	sequence="30"/>	

		<menuitem  id="menu_credit_limit_config" 
		   	name="Configuración del límite de crédito" 
			action="action_list_credit_limit_settings" 
    	   	groups="control_credit_limit.group_cartera"
        	sequence="40"/>			

	</menuitem>			

</odoo> 
