<?xml version="1.0" ?>
  <odoo>
    <data>
      <record id="create_payment_payslip_form" model="ir.ui.view">
        <field name="name">create.payment.payslip.form</field>
        <field name="model">create.payment.payslip</field>
        <field name="arch" type="xml">
          <form string="Generar pagos de nómina">
            <group>
              <field name="date_payment" required="1"/>
              <field name="journal_id" required="1" 
                                       domain="[('type', '=', 'bank')]" 
                                       context="{'default_type':'bank'}"
                                       options="{'no_create': True, 'no_open': True}"/>
              </group>
            <footer>
              <button string="Generar" name="create_payment" type="object" class="oe_highlight"/>
              <button string="Cancelar" class="oe_link" special="cancel" />
            </footer>
          </form>
        </field>
      </record>

      <record id="create_payment_payslip_action" model="ir.actions.server">
        <field name="name">Generar pagos</field>
        <field name="model_id" ref="hr_payroll_co.model_create_payment_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.open_wizard()</field>
      </record>
         

    </data>
  </odoo>