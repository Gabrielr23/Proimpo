    <record id="view_hr_account_payslip_form_inherit" model="ir.ui.view">
        <field name="name">hr.account.payslip.form.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_payslip_done']" position="replace">
                    <button string="Contabilizar nómina" name="action_payslip_done" type="object" invisible="[('state', 'not in',('verify','draft'))]" class="oe_highlight" context="{'payslip_generate_pdf': True}" confirm="Are you sure you want to proceed ?"/>
            </xpath>
            <xpath expr="//button[@name='refund_sheet']" position="before">
                <button string="Romper conciliación" name="action_payslip_break_conciliation" type="object" invisible="state != 'paid'" class="oe_highlight" confirm="Esta seguro(a) de romper la conciliación?"/>
            </xpath>

            <xpath expr="//field[@name='paid_date']" position="after">
				<field name="payment_id" invisible="payment_id == False" readonly="1"/>
            </xpath>
			
        </field>    
    </record>
 
           
                
</odoo>




