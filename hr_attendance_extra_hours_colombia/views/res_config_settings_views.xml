<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.attendance.extra.hours</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Buscar cualquier campo del módulo hr_attendance y agregar después -->
            <xpath expr="//field[@name='hr_attendance_overtime']" position="after">
                <setting id="attendance_extra_hours_colombia" string="Configuración Horas Extras Colombia" 
                         help="Configure los parámetros para el cálculo de horas extras según legislación colombiana">
                    <div class="content-group mt16">
                        <div class="row mt16">
                            <label for="attendance_nocturnal_start" class="col-lg-4 o_light_label" string="Inicio Nocturno"/>
                            <field name="attendance_nocturnal_start" class="oe_inline" widget="float_time"/>
                            <span class="ml8">(Ej: 21.0 = 9:00 PM)</span>
                        </div>
                        <div class="row mt8">
                            <label for="attendance_nocturnal_end" class="col-lg-4 o_light_label" string="Fin Nocturno"/>
                            <field name="attendance_nocturnal_end" class="oe_inline" widget="float_time"/>
                            <span class="ml8">(Ej: 6.0 = 6:00 AM)</span>
                        </div>
                        <div class="row mt8">
                            <label for="attendance_extra_rounding" class="col-lg-4 o_light_label" string="Redondeo (minutos)"/>
                            <field name="attendance_extra_rounding" class="oe_inline"/>
                            <span class="ml8">(Ej: 15 = cuartos de hora)</span>
                        </div>
                    </div>
                    <div class="alert alert-info mt16" role="alert">
                        <strong>Legislación Colombiana:</strong>
                        <ul class="mb-0">
                            <li>Horario Diurno: 6:00 AM - 9:00 PM</li>
                            <li>Horario Nocturno: 9:00 PM - 6:00 AM</li>
                            <li>Las horas extras se calculan automáticamente al superar el horario planificado</li>
                        </ul>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>