<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Motor genérico de controles por horas.
            Corre cada 15 minutos y, dentro del método, cada punto de
            control decide si ya le toca generar (según su propio
            hourly_control_interval). 15 minutos da margen suficiente
            para intervalos de 1-2 horas sin sobrecargar el scheduler.

            Se entrega INACTIVO (active=False) a propósito: actívese
            solo después de probar la generación manualmente (botón
            "Ejecutar Manualmente" en Ajustes > Técnico > Automatización
            > Acciones Programadas) con al menos un punto de control de
            prueba, para no afectar el ambiente compartido mientras se
            valida.
        -->
        <record id="ir_cron_hourly_quality_checks" model="ir.cron">
            <field name="name">Calidad: generar controles por horas (motor propio)</field>
            <field name="model_id" ref="quality_control.model_quality_point"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_hourly_quality_checks()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
