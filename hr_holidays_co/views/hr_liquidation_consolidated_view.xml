<odoo>
    <data>
		
    <!-- Calculo de Retención -->
   
	<record model="ir.ui.view" id="hr_liquidation_consolidated_list_view">
		<field name="name">hr.liquidation.consolidated.list.view</field>
		<field name="model">hr.liquidation.consolidated</field>
		<field name="type">list</field>
		<field name="arch" type="xml">
			<list string='Liquidación consolidados'>
			      <field name="name"></field>
                  <field name="date_liquidation"></field>
                  <field name="state"></field>
			</list>
		</field>
	</record>	
	
	<record model="ir.ui.view" id="hr_liquidation_consolidated_form_view">
		<field name="name">hr.liquidation.consolidated.form.view</field>
		<field name="model">hr.liquidation.consolidated</field>
		<field name="type">form</field>
		<field name="arch" type="xml">
			<form string="Liquidación prestaciones sociales">
				<header>
					<button string="Calcular" type="object" class="oe_highlight" name="action_calculate" invisible="state != 'draft'" confirm="Esta seguro(a) de calcular las prestaciones sociales?"/>
					<button string="Confirmar" type="object" name="action_confirm" invisible="state != 'draft'" confirm="Esta seguro(a) de confirmar los cálculos de las prestaciones sociales?"/>
					<button string="Crear novedades" type="object" class="oe_highlight" name="action_create_novedades" invisible="state != 'done' or novedades_count != 0"/>
                    <button name="export_xls" type="object" string="Reporte" invisible="details_count == 0"/>	    
					<button string="Cancelar" type="object" name="action_cancel" invisible="state != 'done'" confirm="Esta seguro(a) de anular los calculos de las prestaciones sociales? Se eliminarán las novedades asociadas. Si tiene nómina generada debe revisarla y recalcular"/>
					<button string="Cambiar a borrador" type="object" name="action_draft" invisible="state != 'cancel'" confirm="Esta seguro(a) de cambiar a borrador?"/>
					<field name='state' widget="statusbar"/>
				</header>
				<sheet>	
				    <div class="oe_button_box" name="button_box">
						<button name="show_details" type="object" class="oe_stat_button" icon="fa-list-alt"
							invisible="details_count == 0">
							<field name="details_count" widget="statinfo" string="Detalle"/>
						</button>						
						<button name="show_novedades" type="object" class="oe_stat_button" icon="fa-list-alt"
							invisible="novedades_count == 0">
							<field name="novedades_count" widget="statinfo" string="Novedades"/>
						</button>								
					</div>				
				    <group string="Periodo">
						<group>
						    <field name="name" readonly="state != 'draft'"></field>
							<field name="date_liquidation" readonly="state != 'draft'"></field>
							<field name="liquidation_prima" readonly="state != 'draft'"></field>
							<field name="liquidation_cesantias" readonly="state != 'draft'"></field>
							<field name="liquidation_vacaciones" readonly="state != 'draft'"></field>
							<field name="date_vacaciones" readonly="state != 'draft'" invisible="not liquidation_vacaciones"></field>
						</group>						
					</group>	
					<notebook>
						<page string="Empleados">
							<field name="employee_ids">
								<list>
									<field name="name"/>
								</list>
							</field>
						</page>
					</notebook>					
				</sheet>	
			</form>
		</field>
	</record>

	<record id="hr_liquidation_consolidated_action" model="ir.actions.act_window">
			 <field name="name">Lotes de prestaciones sociales</field>
			 <field name="res_model">hr.liquidation.consolidated</field>
			 <field name="view_mode">list,form</field>
	</record>

    <menuitem name="Prestaciones sociales" sequence="95" id="menu_liquidation_consolidated_root" parent="hr_payroll.menu_hr_payroll_payslips" groups="hr_payroll.group_hr_payroll_user"/>	
    	
	<menuitem id="hr_liquidation_consolidated" name="Lotes"
	 parent="menu_liquidation_consolidated_root" action="hr_liquidation_consolidated_action" sequence="10"/>		    

    <!-- Detalle -->
	
	<record model="ir.ui.view" id="hr_contract_liquidation_details_list_view">
		<field name="name">hr.contract.liquidation.details.list.view</field>
		<field name="model">hr.contract.liquidation.details</field>
		<field name="type">list</field>
		<field name="arch" type="xml">
			<list string='Prestaciones sociales'>
			      <field name="employee_id"></field>
                  <field name="date_from"></field>
				  <field name="date_to"></field>
				  <field name="liquidation_type"></field>
				  <field name="amount"></field>
			</list>
		</field>
	</record>		
	
    <record id="hr_contract_liquidation_details_search" model="ir.ui.view">
        <field name="name">hr.liquidation.consolidated.details.search</field>
        <field name="model">hr.contract.liquidation.details</field>
        <field name="arch" type="xml">
            <search string="Búsqueda liquidación">
                <field name="employee_id"/>   
				<field name="liquidation_type"/>
                <group expand="0" string="Group By...">
                    <filter
                        name="group_by_liquidation_type"
                        string="Concepto"
                        context="{'group_by':'liquidation_type'}"
                    />
                </group>		
            </search>
            </field>
    </record>                

	<record id="hr_contract_liquidation_details_action" model="ir.actions.act_window">
			 <field name="name">Detalle de prestaciones sociales</field>
			 <field name="res_model">hr.contract.liquidation.details</field>
			 <field name="view_mode">list,form</field>
	</record>
	
	<menuitem id="hr_contract_liquidation_details_menu" name="Detalle"
	 parent="menu_liquidation_consolidated_root" action="hr_contract_liquidation_details_action" sequence="20"/>	
	 
	 
				
    </data>
</odoo>




