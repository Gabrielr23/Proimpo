<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_salary_rule_view_inherit" model="ir.ui.view">
      <field name="name">hr.salary.rule.view.inherit</field>
      <field name="model">hr.salary.rule</field>
      <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='appears_on_payslip']" position="after">
            <field name="liquidation_type"/>
			<field name="average_salary"/>
			<field name="average_salary_vacation"/>
        </xpath>
      </field>
    </record>

</odoo>
