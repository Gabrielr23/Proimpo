<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_type_view_inherit" model="ir.ui.view">
      <field name="name">hr.leave_type.view.inherit</field>
      <field name="model">hr.leave.type</field>
      <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='time_type']" position="after">
            <field name="reason_leave"/>
        </xpath>
      </field>
    </record>

    <record id="hr_leave_view_inherit" model="ir.ui.view">
      <field name="name">hr.leave.view.inherit</field>
      <field name="model">hr.leave</field>
      <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='duration_display']" position="after">
        <field name="reason_leave" invisible="1"/>
        <div invisible="reason_leave == 'other'">
			<field name="number_of_days_real" nolabel="1" class="text-success" style="width: 2rem;"/> Días hábiles
        </div>
        </xpath>
		<xpath expr="(//group[@name='col_left']/div)[last()]" position="after">
		        <label for="period_date_from" invisible="reason_leave != 'vacation'" string="Periodo vacaciones"/>
                <field nolabel="1" name="period_date_from" widget="daterange" invisible="reason_leave != 'vacation'" readonly="state not in ('draft', 'confirm')" required="reason_leave == 'vacation'" options="{'end_date_field': 'period_date_to'}"/>
                <field name="period_date_to" invisible="1"/>		    
		   
		</xpath>
      </field>
    </record>

</odoo>
