<odoo>
    <data>

	<record model="ir.ui.view" id="hr_previous_payrolls_list_view">
		<field name="name">hr.previous.payrolls.list.view</field>
		<field name="model">hr.previous.payrolls</field>
		<field name="type">list</field>
		<field name="arch" type="xml">
			<list string='Nóminas anteriores'>
                  <field name="date"></field>
				  <field name="employee_id"></field>
				  <field name="salary_rule_id"></field>
                  <field name="value"></field>
			</list>
		</field>
	</record>
   
	<record model="ir.ui.view" id="hr_previous_payrolls_form_view">
		<field name="name">hr.previous.payrolls.form.view</field>
		<field name="model">hr.previous.payrolls</field>
		<field name="type">form</field>
			<field name="arch" type="xml">
				<form string="Nóminas anteriores">
					<group col="4">
				      <field name="salary_rule_id" options="{'no_create': True}"></field>
                      <field name="date"></field>
                      <field name="employee_id" options="{'no_create': True}"></field>
                      <field name="value"></field>
                    </group>  
				</form>
			</field>
	</record>

    <record id="hr_previous_payrolls_search_view" model="ir.ui.view">
        <field name="name">hr.previous.payrolls.search.view</field>
        <field name="model">hr.previous.payrolls</field>
        <field name="arch" type="xml">
            <search string="Search novedades">
			    <field name="employee_id"/>
                <field name="salary_rule_id"/>
                <field name="date"/>                   
            </search>
        </field>
    </record>	
	
	<record id="hr_previous_payrolls_action" model="ir.actions.act_window">
			 <field name="name">Nóminas anteriores</field>
			 <field name="res_model">hr.previous.payrolls</field>
			 <field name="view_mode">list,form</field>
	</record>
	
	<menuitem id="hr_previous_payrolls" name="Nóminas anteriores"
	 parent="hr_payroll.menu_hr_payroll_payslips" action="hr_previous_payrolls_action" sequence="80"/>		    
                
    </data>
</odoo>




