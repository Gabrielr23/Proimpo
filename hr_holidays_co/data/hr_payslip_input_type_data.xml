        <field name="country_id" ref="base.co"/>
    </record>
	
    <record id="hr_payslip_input_type_prima" model="hr.payslip.input.type">
        <field name="name">Ajuste provisión prima</field>
        <field name="code">AJUSTE_PRIMA</field>
		<field name="liquidation_type">PP</field>
        <field name="country_id" ref="base.co"/>
    </record>	
	
    <record id="hr_payslip_input_type_vacaciones" model="hr.payslip.input.type">
        <field name="name">Ajuste provisión vacaciones</field>
        <field name="code">AJUSTE_VACACIONES</field>
		<field name="liquidation_type">PV</field>
        <field name="country_id" ref="base.co"/>
    </record>		
