<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Parámetros de reglas -->

    <record id="hr_payslip_input_type_cesantias" model="hr.payslip.input.type">
        <field name="name">Ajuste provisión cesantías</field>
        <field name="code">AJUSTE_CESANTIAS</field>
		<field name="liquidation_type">PC</field>
        <field name="country_id" ref="base.co"/>
    </record>

    <record id="hr_payslip_input_type_intereses" model="hr.payslip.input.type">
        <field name="name">Ajuste provisión intereses de cesantía</field>
        <field name="code">AJUSTE_INTERESES</field>
