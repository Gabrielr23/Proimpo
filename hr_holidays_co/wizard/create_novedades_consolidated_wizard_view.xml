<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_novedades_consolidated_wizard" model="ir.ui.view">
        <field name="name">view.create.novedades.consolidated.wizard</field>
        <field name="model">create.novedades.consolidated.wizard</field>
        <field name="arch" type="xml">
            <form string="Liquidación de prestaciones">
                <p>
                Crea las novedades de prestaciones sociales.
				Opcionalmente puede actualizar las nóminas para para el rango de fecha dado.
                </p>
				<group>
				   <group>
				     <field name="date_start"/>
				   </group>
				   <group>
				     <field name="date_stop"/>
				   </group>				   
				</group>
				<field name="liquidation_prima" invisible="1"/>
				<field name="liquidation_cesantias" invisible="1"/>
				<field name="liquidation_vacaciones" invisible="1"/>
				<group>
					<field name="ajuste_prima" invisible="not liquidation_prima"></field>
					<field name="ajuste_cesantias" invisible="not liquidation_cesantias"></field>
					<field name="ajuste_vacaciones" invisible="not liquidation_vacaciones"></field>							
				</group>				
                <footer>
                    <button name="create_novedades" string="Crear novedades" type="object" class="btn-primary"/>
					<button name="update_payslip" string="Actualizar nóminas" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_novedades_consolidated_wizard" model="ir.actions.act_window">
        <field name="name">Crear novedades de prestaciones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">create.novedades.consolidated.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_holidays_co.view_create_novedades_consolidated_wizard" />
		<field name="target">new</field>
    </record>

</odoo>
