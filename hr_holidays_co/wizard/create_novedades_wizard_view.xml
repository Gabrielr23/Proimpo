<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_novedades_wizard" model="ir.ui.view">
        <field name="name">view.create.novedades.wizard</field>
        <field name="model">create.novedades.wizard</field>
        <field name="arch" type="xml">
            <form string="Liquidación de contrato">
                <p>
                Crea las novedades de cada uno de los conceptos de nómina ya calculados.
				Adicionalmente puede crear la nómina para la liquidación pasando los mismos conceptos calculados.
                </p>
				<group>
				   <group>
				     <field name="date_start"/>
				   </group>
				   <group>
				     <field name="date_stop"/>
				   </group>	
                   <group>
				     <field name="exist_payslip" invisible="1"/>
				     <field name="struct_id" options="{'no_create': True}" invisible="exist_payslip == True"/>
				   </group>				   
				</group>
                <footer>
                    <button name="create_novedades" string="Crear novedades" type="object" class="btn-primary"/>
					<button name="create_payslip" string="Crear nómina" invisible="exist_payslip == True" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_novedades_wizard" model="ir.actions.act_window">
        <field name="name">Crear novedades</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">create.novedades.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_holidays_co.view_create_novedades_wizard" />
		<field name="target">new</field>
    </record>

</odoo>
