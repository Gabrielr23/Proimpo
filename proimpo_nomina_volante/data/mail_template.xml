<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_volante" model="mail.template">
        <field name="name">Volante de pago</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="subject">Comprobante de pago {{ object.number or '' }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email or '') }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:13px;color:#333;">
                <p>Cordial saludo, <t t-out="object.employee_id.name or ''"/>.</p>
                <p>Adjunto encontrará su comprobante de pago correspondiente al período
                   <t t-out="object.date_from or ''"/> al <t t-out="object.date_to or ''"/>.</p>
                <p>Cualquier inquietud, comuníquese con el área de Nómina.</p>
                <p>Atentamente,<br/><t t-out="object.company_id.name or ''"/></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
