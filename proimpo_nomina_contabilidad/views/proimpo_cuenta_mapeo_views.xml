<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="proimpo_cuenta_mapeo_list" model="ir.ui.view">
        <field name="name">proimpo.cuenta.mapeo.list</field>
        <field name="model">proimpo.cuenta.mapeo</field>
        <field name="arch" type="xml">
            <list string="Mapeo cuentas nomina" editable="bottom">
                <field name="rule_code"/>
                <field name="rule_name"/>
                <field name="area"/>
                <field name="account_debit_id"/>
                <field name="account_credit_id"/>
            </list>
        </field>
    </record>

    <record id="proimpo_cuenta_mapeo_form" model="ir.ui.view">
        <field name="name">proimpo.cuenta.mapeo.form</field>
        <field name="model">proimpo.cuenta.mapeo</field>
        <field name="arch" type="xml">
            <form string="Mapeo cuenta nomina">
                <sheet>
                    <group>
                        <group>
                            <field name="rule_code"/>
                            <field name="rule_name"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="account_debit_id"/>
                            <field name="account_credit_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_proimpo_cuenta_mapeo" model="ir.actions.act_window">
        <field name="name">Mapeo cuentas nomina (por area)</field>
        <field name="res_model">proimpo.cuenta.mapeo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_proimpo_cuenta_mapeo"
              name="Cuentas nomina por area"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_proimpo_cuenta_mapeo"
              sequence="99"/>
    <record id="action_aplicar_cuentas_reglas" model="ir.actions.server">
        <field name="name">Aplicar cuentas por defecto a las reglas</field>
        <field name="model_id" ref="proimpo_nomina_contabilidad.model_proimpo_cuenta_mapeo"/>
        <field name="binding_model_id" ref="proimpo_nomina_contabilidad.model_proimpo_cuenta_mapeo"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.aplicar_a_reglas()</field>
    </record>

</odoo>
