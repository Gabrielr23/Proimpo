<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de configuración de Nómina Electrónica en la empresa -->
    <record id="view_company_form_payroll_edi" model="ir.ui.view">
        <field name="name">res.company.form.payroll.edi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <page name="general_information" position="after">
                <page name="payroll_edi" string="Nómina Electrónica DIAN">
                    <group string="Configuración General">
                        <field name="type_document_identification_id"/>
                        <field name="type_organization_id"/>
                        <field name="type_regime_id"/>
                        <field name="municipality_id"/>
                    </group>
                    <group string="Habilitación Nómina Electrónica">
                        <field name="edi_payroll_enable"/>
                        <field name="edi_payroll_is_not_test"
                               invisible="not edi_payroll_enable"/>
                        <field name="edi_payroll_consolidated_enable"
                               invisible="not edi_payroll_enable"/>
                        <field name="edi_payroll_enable_validate_state"
                               invisible="not edi_payroll_enable"/>
                        <field name="edi_payroll_always_validate"
                               invisible="not edi_payroll_enable"/>
                    </group>
                    <group string="Credenciales DIAN"
                           invisible="not edi_payroll_enable">
                        <field name="edi_payroll_id"/>
                        <field name="edi_payroll_pin" password="True"/>
                        <field name="edi_payroll_test_set_id"
                               invisible="edi_payroll_is_not_test"/>
                    </group>
                    <group string="Certificado Digital (Certicámara)"
                           invisible="not edi_payroll_enable">
                        <field name="dian_certificate_p12"
                               filename="dian_certificate_p12_filename"/>
                        <field name="dian_certificate_p12_filename" invisible="1"/>
                        <field name="dian_certificate_password" password="True"/>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
